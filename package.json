{
  "name": "nett-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b --pretty false",
    "test": "npm run test:smoke && npm run test:unit",
    "test:smoke": "tsx server/smoke.ts",
    "test:unit": "node --import tsx --test \"server/**/__tests__/*.test.ts\" \"src/**/__tests__/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e && npm run build",
    "demo:record": "tsx scripts/demo/record.ts"
  },
  "dependencies": {
    "@countrystatecity/countries": "^1.0.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@motionone/utils": "^10.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "libphonenumber-js": "^1.13.8",
    "liquid-gooey": "^0.1.0",
    "motion": "^12.43.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "swapy": "^1.0.5",
    "tailwind-merge": "^2.5.5",
    "teleproto": "^1.228.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
