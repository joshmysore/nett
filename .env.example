# Optional database location. Tests set this to a temporary path.
# NETT_DB_PATH=/absolute/path/to/nett.db

# Optional: point the read-only Messages connector at a copied database.
# NETT_MESSAGES_DB=/absolute/path/to/messages.db

# Region used only for national-format phone numbers. International numbers retain their country code.
NETT_PHONE_REGION=US

# Incremental Messages rows processed per transaction (50-2000).
NETT_MESSAGES_BATCH_SIZE=500

# Local API port. The Vite development proxy expects 4174 by default.
PORT=4174
